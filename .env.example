# ── LLM configuration ──────────────────────────────────────────────
# mock    = fully offline, rule-based/extractive logic. No key needed,
#           no internet needed. This is the default — the app always
#           runs, e.g. during a viva or interview demo with no wifi.
# openai  = wire in a real GPT model (needs OPENAI_API_KEY below and
#           `pip install -r requirements-llm.txt`)
# anthropic = wire in a real Claude model (needs ANTHROPIC_API_KEY below
#           and `pip install -r requirements-llm.txt`)
LLM_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── App behaviour ────────────────────────────────────────────────────
DEBUG=False
LOG_LEVEL=INFO

# ── NLP ──────────────────────────────────────────────────────────────
SPACY_MODEL=en_core_web_sm
MAX_PDF_SIZE_MB=15

# ── OCR fallback for scanned/image-only PDFs ─────────────────────────
OCR_ENABLED=True
TESSERACT_CMD=

# ── Deployment environment ───────────────────────────────────────────
# development = insecure JWT default is only warned about, not enforced.
# production  = set JWT_SECRET_KEY below to a real random secret.
ENV=development

# ── Backend API / Postgres ───────────────────────────────────────────
# Point this at your already-running local Postgres instance.
DATABASE_URL=postgresql+psycopg2://mediagent:mediagent@localhost:5432/mediagent
CORS_ALLOWED_ORIGIN=http://localhost:5173

# ── Auth (JWT via httpOnly cookie) ───────────────────────────────────
JWT_SECRET_KEY=dev-only-insecure-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720
AUTH_COOKIE_NAME=mediagent_session

# ── Email notifications ──────────────────────────────────────────────
# mock = logs the email instead of sending it (default, no setup needed).
# smtp = sends via the SMTP settings below (e.g. a Gmail app password).
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@mediagent.local
SMTP_USE_TLS=True

# ── Speech-to-text (transcript-to-report agent) ──────────────────────
# whisper_local     = pip `openai-whisper`, no API key, needs system ffmpeg.
# openai_whisper_api = uses OPENAI_API_KEY above via the Whisper API instead.
STT_PROVIDER=whisper_local
WHISPER_MODEL_SIZE=base
